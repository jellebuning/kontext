<UserControl
    x:Class="Kontext.Views.SignInView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel
        MaxWidth="440"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Spacing="16">

        <Image
            Width="72"
            Height="72"
            HorizontalAlignment="Left"
            AutomationProperties.AccessibilityView="Raw"
            Source="ms-appx:///Assets/Kontext.png" />

        <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Sign in to GitHub" />

        <TextBlock
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Style="{StaticResource BodyTextBlockStyle}"
            TextWrapping="Wrap">
            Kontext signs you in with your GitHub account. You approve it on github.com; no password or token is typed here.
        </TextBlock>

        <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.HasDeviceCode, Mode=OneWay}">
            <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="Enter this code on GitHub:" />
            <TextBlock
                IsTextSelectionEnabled="True"
                Style="{StaticResource TitleLargeTextBlockStyle}"
                Text="{x:Bind ViewModel.UserCode, Mode=OneWay}" />
            <HyperlinkButton
                Padding="0"
                Content="Open github.com/login/device"
                NavigateUri="{x:Bind ViewModel.VerificationUrl, Mode=OneWay}" />
        </StackPanel>

        <InfoBar
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
            Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            Severity="Error" />

        <StackPanel Orientation="Horizontal" Spacing="12">
            <Button
                Command="{x:Bind ViewModel.SignInCommand}"
                Content="Sign in with GitHub"
                Style="{StaticResource AccentButtonStyle}" />
            <Button
                Command="{x:Bind ViewModel.SignInCancelCommand}"
                Content="Cancel"
                Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
            <ProgressRing
                Width="20"
                Height="20"
                IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
        </StackPanel>
    </StackPanel>
</UserControl>