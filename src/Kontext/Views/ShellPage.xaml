<Page
    x:Class="Kontext.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Kontext.Views">

    <Grid>
        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="16"
            Visibility="{x:Bind ViewModel.IsStarting, Mode=OneWay}">
            <Image
                Width="72"
                Height="72"
                AutomationProperties.AccessibilityView="Raw"
                Source="ms-appx:///Assets/Kontext.png" />
            <ProgressRing
                Width="40"
                Height="40"
                IsActive="{x:Bind ViewModel.IsStarting, Mode=OneWay}" />
            <TextBlock
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Signing in…" />
        </StackPanel>

        <views:SignInView
            Margin="24"
            ViewModel="{x:Bind ViewModel}"
            Visibility="{x:Bind ViewModel.ShowSignIn, Mode=OneWay}" />

        <views:WorkspaceView
            ControlHost="{x:Bind ControlHost}"
            ViewModel="{x:Bind ViewModel}"
            Visibility="{x:Bind ViewModel.IsSignedIn, Mode=OneWay}" />
    </Grid>
</Page>
